---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import HomeHero from "../components/HomeHero.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import { articleCardData } from "../lib/article-card-data";
import { featuredArticleData } from "../lib/featured-article-data";
import { getCollection } from "astro:content";
import { getPublicArticles, orderPublicArticles } from "../lib/articles";
import { splitLatestPublicationWeek } from "../lib/article-week";

const ordered = orderPublicArticles(getPublicArticles(await getCollection("articles")), "latest");
const { weekly, previous } = splitLatestPublicationWeek(ordered);
const featured = await Promise.all(weekly.map(featuredArticleData));
const previousArticles = await Promise.all(previous.slice(0, 6).map(articleCardData));
---
<SiteLayout title="홈 | Duckurity News" description="이번 주 보안 소식과 이전에 게시된 이야기를 만나보세요." page="newsletter">
  <main id="main" class="site-main shell">
    <HomeHero showMascot articleHref={featured[0]?.href} />
    <FeaturedArticle articles={featured} />
    <section class="newsletter-previous" aria-labelledby="previous-articles-title">
      <div class="home-section-heading"><h2 id="previous-articles-title">더 읽어볼까요?</h2></div>
      <ol class="article-list" id="newsletter-articles">{previousArticles.map((article) => <ArticleCard article={article} compact />)}</ol>
    </section>
  </main>
</SiteLayout>
