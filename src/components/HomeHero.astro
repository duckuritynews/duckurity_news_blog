---
import { home } from "../config/home";
interface Props { articleHref?: string | undefined }
const { articleHref } = Astro.props;
---
<section class="home-hero" aria-labelledby="page-title">
  <div class="home-hero__copy">
    <span class="home-badge home-badge--weekly">MR.DUCK'S WEEKLY LETTER</span>
    <h1 id="page-title">{home.title}</h1>
    <p>{home.description}</p>
    <div class="home-actions">
      {articleHref ? <a class="home-button home-button--coral" href={articleHref}>이번 주 보안 소식 읽기<span aria-hidden="true"> ↗</span></a> : <button class="home-button" disabled>이번 주 보안 소식 읽기</button>}
      {home.subscriptionUrl ? <a class="home-button home-button--outline" href={home.subscriptionUrl}>뉴스레터 구독</a> : <button class="home-button home-button--outline" type="button" disabled title="뉴스레터 구독 서비스 준비 중">뉴스레터 구독</button>}
    </div>
  </div>
  <div class="home-image-slot home-hero__image" aria-hidden="true"><span>마스코트 이미지 준비 중</span></div>
</section>
