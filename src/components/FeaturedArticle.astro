---
import type { FeaturedArticleData } from "../lib/featured-article-data";
interface Props { articles: FeaturedArticleData[] }
const { articles } = Astro.props;
---
<section class="home-feature" aria-labelledby="featured-title" data-weekly-carousel>
  <div class="home-section-heading"><h2 id="featured-title">이번 주 픽</h2></div>
  {articles.length ? <div class="home-feature__slides" data-weekly-viewport aria-roledescription="슬라이드 모음">
    {articles.map((article, index) => <article class="home-feature__slide" data-weekly-slide data-active={index === 0 ? "true" : undefined} inert={index !== 0} role="group" aria-roledescription="슬라이드" aria-label={`${index + 1} / ${articles.length}`}><a class="home-feature__card" href={article.href} aria-labelledby={`featured-article-title-${index}`}>
    <div class="home-feature__image">
      {article.thumbnail ? <img {...article.thumbnail} loading="lazy" /> : <div class="home-image-slot" aria-hidden="true"><span>대표 이미지 준비 중</span></div>}
    </div>
    <div class="home-feature__copy">
      <h3 id={`featured-article-title-${index}`}>{article.title}</h3>
      <div class="home-feature__footer">
        <div class="home-feature__meta"><time datetime={article.publishedAt}>{new Date(article.publishedAt).toLocaleDateString("ko-KR", { timeZone: "UTC" })}</time>{article.tags.length > 0 && <ul class="home-feature__keywords" aria-label="대표 기사 키워드">{article.tags.slice(0, 2).map((tag) => <li>{tag}</li>)}</ul>}</div>
      </div>
    </div>
    </a></article>)}
  </div> : <p class="empty-state">아직 게시된 기사가 없습니다.</p>}
  {articles.length > 1 && <nav class="home-feature__pagination" aria-label="이번 주 픽 페이지" data-weekly-controls hidden>
    <button class="home-feature__page" type="button" data-weekly-previous aria-label="이전 기사">‹</button>
    <span data-weekly-page aria-live="off">1 / {articles.length}</span>
    <button class="home-feature__autoplay" type="button" data-weekly-autoplay aria-label="자동 넘김 정지" title="자동 넘김 정지" aria-pressed="false">
      <span data-weekly-pause-icon aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M8 5v14M16 5v14" /></svg></span>
      <span data-weekly-play-icon aria-hidden="true" hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 11 7-11 7Z" /></svg></span>
    </button>
    <button class="home-feature__page" type="button" data-weekly-next aria-label="다음 기사">›</button>
    <span class="sr-only" data-weekly-announcement aria-live="polite"></span>
  </nav>}
  <script>import "../scripts/weekly-carousel-client.js";</script>
</section>
