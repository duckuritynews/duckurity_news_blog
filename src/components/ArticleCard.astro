---
import type { ArticleCardData } from "../lib/article-card-data";
interface Props { article: ArticleCardData; compact?: boolean }
const { article, compact = false } = Astro.props;
const date = new Date(article.publishedAt);
const Heading = compact ? "h3" : "h2";
const titleId = `article-card-title-${article.slug}`;
---
<li class:list={["article-card", { "article-card--compact": compact }]}>
  <a class="article-card__link" href={article.href} aria-labelledby={titleId}>
    <div class="article-card__media">{article.thumbnail ? <img {...article.thumbnail} loading="lazy" /> : <div class="home-image-slot" aria-hidden="true"><span>썸네일 준비 중</span></div>}</div>
    <div class="article-card__body">
      {!compact && <div class="card-meta"><time datetime={date.toISOString()}>{date.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time></div>}
      <Heading class="article-card__title" id={titleId}><span class="article-card__title-link">{article.title}</span></Heading>
      {!compact && <p class="article-card__summary">{article.summary}</p>}
      <div class="article-card__footer">
        <ul class="tags" aria-label="기사 태그">{article.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
        {compact ? <span class="article-card__arrow" data-liquid-glass="control" aria-hidden="true">→</span> : <span class="article-card__read" aria-hidden="true">읽으러 가기 →</span>}
      </div>
    </div>
  </a>
</li>
